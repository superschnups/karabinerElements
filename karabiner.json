                        "eval_js": "// JavaScript must be written in ECMAScript 5.1.\n\nfunction main() {\n  const apps = [\n    { key_code: '1', app: 'com.vivaldi.Vivaldi' },\n    { key_code: '2', app: 'com.apple.TextEdit' },\n    { key_code: '3', app: 'com.apple.ActivityMonitor' },\n  ]\n\n  const manipulators = []\n  for (var i = 0; i < apps.length; ++i) {\n    const app = apps[i]\n\n    console.log('left_option+' + app.key_code + ' to ' + app.app)\n\n    manipulators.push({\n      type: 'basic',\n      from: {\n        key_code: app.key_code,\n        modifiers: {\n          mandatory: ['left_option'],\n        },\n      },\n      to: [\n        {\n          software_function: {\n            open_application: { bundle_identifier: app.app },\n          },\n        },\n      ],\n    })\n  }\n\n  return {\n    description: 'Open apps with left_option 1/2/3',\n    manipulators: manipulators,\n  }\n}\n\nmain()\n"
                    },
