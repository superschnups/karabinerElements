{
  "title": "Start Vivaldi mit Option+W",
  "rules": [
    {
      "description": "Option+W → Vivaldi starten",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "w",
            "modifiers": {
              "mandatory": ["left_option"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Vivaldi"
            }
          ]
        }
      ]
    }
  ]
}
